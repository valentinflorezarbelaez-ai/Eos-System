# --- NEW FILE: tests/context-compiler-contract.test.js ---
import test from 'node:test';
import assert from 'node:assert/strict';
import crypto from 'node:crypto';
import { ContextCompiler } from '../scripts/engine/context-compiler.js';

test('ContextCompiler Contract Suite', async (t) => {
  await t.test('Flat input propagates missionId, targetProject, and maxBudgetTokens', () => {
    const receipt = ContextCompiler.compileMissionContext({
      missionId: 'MIS-PILOT-READONLY-001',
      targetProject: 'PRJ-EOS-SYSTEM',
      maxBudgetTokens: 2000,
      rawPrompt: 'Verify flat prompt compilation'
    });

    assert.equal(receipt.missionId, 'MIS-PILOT-READONLY-001');
    assert.equal(receipt.tokenBudget.maxBudgetTokens, 2000);
    assert.ok(receipt.compiledPrompt.includes('=== MISSION CONTEXT: MIS-PILOT-READONLY-001 ==='));
    assert.ok(receipt.compiledPrompt.includes('Project: PRJ-EOS-SYSTEM'));
    assert.ok(receipt.compiledPrompt.includes('Goal: Verify flat prompt compilation'));
    
    // Receipt hash check
    const expectedHash = crypto.createHash('sha256').update(receipt.compiledPrompt).digest('hex');
    assert.equal(receipt.sha256, expectedHash);
  });

  await t.test('Nested input preserves backward compatibility', () => {
    const receipt = ContextCompiler.compileMissionContext({
      mission: { id: 'MIS-NESTED-002', type: 'DEVELOPMENT', goal: 'Build authentication' },
      project: { id: 'PRJ-CORE', rootPath: '.', activeScope: ['src/core'] },
      contract: { autonomyLevel: 'LEVEL_1', maxBudgetTokens: 3000, reserveCompletionTokens: 400 },
      constraints: ['Strict zero mutation on external targets'],
      instructions: ['Run tests before submit']
    });

    assert.equal(receipt.missionId, 'MIS-NESTED-002');
    assert.equal(receipt.tokenBudget.maxBudgetTokens, 3000);
    assert.ok(receipt.compiledPrompt.includes('=== MISSION CONTEXT: MIS-NESTED-002 ==='));
    assert.ok(receipt.compiledPrompt.includes('Project: PRJ-CORE (Scope: src/core)'));
    assert.ok(receipt.compiledPrompt.includes('Authority: A1 (MCL-1)'));
    assert.ok(receipt.compiledPrompt.includes('[CONSTRAINT] Strict zero mutation'));
  });

  await t.test('Hybrid input prefers explicit nested object over flat fallback', () => {
    const receipt = ContextCompiler.compileMissionContext({
      mission: { id: 'MIS-NESTED-PRIORITY', goal: 'Nested Goal' },
      missionId: 'MIS-FLAT-IGNORE',
      targetProject: 'PRJ-FLAT-PROJECT',
      maxBudgetTokens: 1500
    });

    assert.equal(receipt.missionId, 'MIS-NESTED-PRIORITY');
    assert.equal(receipt.tokenBudget.maxBudgetTokens, 1500);
    assert.ok(receipt.compiledPrompt.includes('=== MISSION CONTEXT: MIS-NESTED-PRIORITY ==='));
    assert.ok(receipt.compiledPrompt.includes('Project: PRJ-FLAT-PROJECT'));
  });

  await t.test('Null or empty input falls back gracefully to safe defaults', () => {
    const receipt = ContextCompiler.compileMissionContext(null);
    assert.equal(receipt.missionId, 'MIS-UNKNOWN');
    assert.equal(receipt.tokenBudget.maxBudgetTokens, 4000);
    assert.ok(receipt.compiledPrompt.includes('=== MISSION CONTEXT: MIS-UNKNOWN ==='));
    assert.ok(receipt.compiledPrompt.includes('Project: PRJ-UNKNOWN'));
  });

  await t.test('compileContext legacy shorthand helper works seamlessly', () => {
    const receipt = ContextCompiler.compileContext('MIS-LEGACY-001', 'NODE-42', 2500);
    assert.equal(receipt.missionId, 'MIS-LEGACY-001');
    assert.equal(receipt.tokenBudget.maxBudgetTokens, 2500);
    assert.ok(receipt.compiledPrompt.includes('Goal: Execute node NODE-42'));
  });
});
