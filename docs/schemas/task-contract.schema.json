{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eos.local/schemas/task-contract.schema.json",
  "title": "EOS Task Contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_id",
    "mission_id",
    "assigned_role",
    "objective",
    "required_outputs",
    "acceptance_criteria",
    "allowed_tools",
    "allowed_read_roots",
    "allowed_write_roots",
    "protected_surfaces",
    "authority_level",
    "budget",
    "stop_conditions",
    "escalation_conditions",
    "status"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "task_id": {
      "type": "string",
      "pattern": "^TASK-[A-Z0-9-]+$"
    },
    "mission_id": {
      "type": "string",
      "pattern": "^MIS-[A-Z0-9-]+$"
    },
    "parent_task_id": {
      "type": ["string", "null"]
    },
    "assigned_role": {
      "type": "string",
      "minLength": 1
    },
    "agent_id": {
      "type": ["string", "null"]
    },
    "objective": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "inputs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ref"
      }
    },
    "required_outputs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/output"
      },
      "minItems": 1
    },
    "acceptance_criteria": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/criterion"
      },
      "minItems": 1
    },
    "allowed_tools": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "allowed_read_roots": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "allowed_write_roots": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "protected_surfaces": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "authority_level": {
      "enum": ["LEVEL_0", "LEVEL_1", "LEVEL_2", "LEVEL_3", "LEVEL_4"]
    },
    "budget": {
      "$ref": "#/$defs/budget"
    },
    "stop_conditions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "escalation_conditions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "rollback_plan": {
      "type": ["string", "null"]
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "status": {
      "enum": [
        "proposed",
        "approved",
        "precondition_failed",
        "running",
        "paused",
        "blocked",
        "completed",
        "failed",
        "cancelled",
        "needs_human"
      ]
    },
    "result_ref": {
      "$ref": "#/$defs/ref"
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ref"
      }
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "$defs": {
    "ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "uri", "sha256"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "uri": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "format", "required"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "format": {
          "type": "string",
          "minLength": 1
        },
        "required": {
          "type": "boolean"
        },
        "max_size_bytes": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "criterion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "statement", "verification_method", "required_status"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "statement": {
          "type": "string",
          "minLength": 1
        },
        "verification_method": {
          "enum": ["test", "inspection", "command", "review", "human_decision"]
        },
        "required_status": {
          "enum": ["VERIFIED", "NOT_VERIFIED", "NOT_RUN", "UNKNOWN", "BLOCKED", "SIMULATION_ONLY"]
        }
      }
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_input_tokens",
        "max_output_tokens",
        "max_tool_calls",
        "max_retries",
        "max_duration_seconds"
      ],
      "properties": {
        "max_input_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "max_output_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "max_tool_calls": {
          "type": "integer",
          "minimum": 0
        },
        "max_retries": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10
        },
        "max_duration_seconds": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  }
}
