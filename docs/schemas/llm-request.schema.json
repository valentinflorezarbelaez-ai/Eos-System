{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eos.local/schemas/llm-request.schema.json",
  "title": "EOS Governed LLM Request Contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "request_id",
    "mission_id",
    "model",
    "messages",
    "authority_level"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "request_id": {
      "type": "string",
      "pattern": "^REQ-[A-Z0-9_-]+$"
    },
    "mission_id": {
      "type": "string",
      "pattern": "^MIS-[A-Z0-9_-]+$"
    },
    "task_id": {
      "type": ["string", "null"]
    },
    "model": {
      "type": "string",
      "minLength": 1
    },
    "messages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["role", "content"],
        "properties": {
          "role": {
            "type": "string",
            "enum": ["system", "user", "assistant"]
          },
          "content": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "structured_output_schema": {
      "type": ["object", "null"]
    },
    "authority_level": {
      "type": "string",
      "minLength": 1
    },
    "budget_constraints": {
      "type": ["object", "null"],
      "properties": {
        "max_input_tokens": { "type": "integer", "minimum": 1 },
        "max_output_tokens": { "type": "integer", "minimum": 1 },
        "max_cost_usd": { "type": "number", "minimum": 0 },
        "timeout_ms": { "type": "integer", "minimum": 100 }
      }
    },
    "metadata": {
      "type": "object"
    }
  }
}
