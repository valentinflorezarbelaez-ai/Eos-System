{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eos.local/schemas/llm-receipt.schema.json",
  "title": "EOS Epistemic LLM Invocation Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "receipt_id",
    "mission_id",
    "provider",
    "model",
    "authorized",
    "authority_level",
    "request_sha256",
    "response_status",
    "validation_result",
    "usage",
    "latency_ms",
    "timestamp",
    "sha256"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "receipt_id": {
      "type": "string",
      "pattern": "^LLM-REC-[A-Z0-9_-]+$"
    },
    "mission_id": {
      "type": "string",
      "pattern": "^MIS-[A-Z0-9_-]+$"
    },
    "task_id": {
      "type": ["string", "null"]
    },
    "provider": {
      "type": "string",
      "enum": ["GOOGLE", "ANTHROPIC", "OPENAI", "META_OLLAMA", "MISTRAL", "CUSTOM_LOCAL"]
    },
    "model": {
      "type": "string",
      "minLength": 1
    },
    "authorized": {
      "type": "boolean"
    },
    "authority_level": {
      "type": "string",
      "minLength": 1
    },
    "request_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "response_sha256": {
      "type": ["string", "null"]
    },
    "response_status": {
      "type": "string",
      "enum": ["COMPLETED", "REJECTED", "FAILED", "BUDGET_EXCEEDED", "AUTH_DENIED", "RATE_LIMITED", "TIMEOUT"]
    },
    "validation_result": {
      "type": "string",
      "enum": ["PASS", "FAIL", "NOT_RUN"]
    },
    "usage": {
      "type": "object",
      "required": ["input_tokens", "output_tokens", "total_tokens"],
      "properties": {
        "input_tokens": { "type": "integer", "minimum": 0 },
        "output_tokens": { "type": "integer", "minimum": 0 },
        "total_tokens": { "type": "integer", "minimum": 0 },
        "estimated_cost_usd": { "type": "number", "minimum": 0 }
      }
    },
    "latency_ms": {
      "type": "number",
      "minimum": 0
    },
    "error_class": {
      "type": ["string", "null"]
    },
    "timestamp": {
      "type": "string"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
