{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eos.local/schemas/model-capability.schema.json",
  "title": "EOS AI Model Capability and Selection Schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "model_id",
    "provider",
    "model_name",
    "capabilities",
    "performance_profile",
    "pricing_usd_per_million",
    "privacy_profile",
    "compatibility_status",
    "evidence"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "model_id": {
      "type": "string",
      "pattern": "^MOD-[A-Z0-9_-]+$"
    },
    "provider": {
      "type": "string",
      "enum": ["ANTHROPIC", "OPENAI", "GOOGLE", "META_OLLAMA", "MISTRAL", "CUSTOM_LOCAL"]
    },
    "model_name": {
      "type": "string",
      "minLength": 1
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_context_window_tokens",
        "max_output_tokens",
        "supports_tool_calling",
        "supports_structured_json",
        "supports_vision",
        "reasoning_depth"
      ],
      "properties": {
        "max_context_window_tokens": { "type": "integer", "minimum": 1024 },
        "max_output_tokens": { "type": "integer", "minimum": 256 },
        "supports_tool_calling": { "type": "boolean" },
        "supports_structured_json": { "type": "boolean" },
        "supports_vision": { "type": "boolean" },
        "reasoning_depth": {
          "type": "string",
          "enum": ["FAST_ROUTINE", "STANDARD_ENGINEERING", "DEEP_COGNITIVE_REASONING"]
        }
      }
    },
    "performance_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["p95_latency_ms", "throughput_tokens_per_sec", "observed_error_rate_pct"],
      "properties": {
        "p95_latency_ms": { "type": "number" },
        "throughput_tokens_per_sec": { "type": "number" },
        "observed_error_rate_pct": { "type": "number", "minimum": 0, "maximum": 100 }
      }
    },
    "pricing_usd_per_million": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input_tokens", "output_tokens"],
      "properties": {
        "input_tokens": { "type": "number", "minimum": 0 },
        "output_tokens": { "type": "number", "minimum": 0 }
      }
    },
    "privacy_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["zero_data_retention", "on_premise_available", "compliance_certifications"],
      "properties": {
        "zero_data_retention": { "type": "boolean" },
        "on_premise_available": { "type": "boolean" },
        "compliance_certifications": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "compatibility_status": {
      "type": "string",
      "enum": [
        "DECLARED_SUPPORT",
        "DISCOVERED_FUNCTIONAL",
        "PROVEN_BENCHMARKED"
      ]
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["benchmark_receipt_id", "sha256_hash"],
      "properties": {
        "benchmark_receipt_id": { "type": ["string", "null"] },
        "sha256_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    }
  }
}
