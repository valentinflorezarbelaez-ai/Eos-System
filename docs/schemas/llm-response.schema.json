{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eos.local/schemas/llm-response.schema.json",
  "title": "EOS Governed LLM Response Contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "provider",
    "model",
    "request_id",
    "status",
    "usage",
    "latency_ms",
    "timestamp"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "provider": {
      "type": "string",
      "enum": ["GOOGLE", "ANTHROPIC", "OPENAI", "META_OLLAMA", "MISTRAL", "CUSTOM_LOCAL"]
    },
    "model": {
      "type": "string",
      "minLength": 1
    },
    "request_id": {
      "type": "string",
      "pattern": "^REQ-[A-Z0-9_-]+$"
    },
    "status": {
      "type": "string",
      "enum": ["COMPLETED", "REJECTED", "FAILED", "BUDGET_EXCEEDED", "AUTH_DENIED", "RATE_LIMITED", "TIMEOUT"]
    },
    "structured_output": {
      "type": ["object", "null"]
    },
    "raw_text": {
      "type": ["string", "null"]
    },
    "usage": {
      "type": "object",
      "required": ["input_tokens", "output_tokens", "total_tokens"],
      "properties": {
        "input_tokens": { "type": "integer", "minimum": 0 },
        "output_tokens": { "type": "integer", "minimum": 0 },
        "total_tokens": { "type": "integer", "minimum": 0 },
        "estimated_cost_usd": { "type": "number", "minimum": 0 }
      }
    },
    "latency_ms": {
      "type": "number",
      "minimum": 0
    },
    "timestamp": {
      "type": "string"
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["code", "message"],
        "properties": {
          "code": { "type": "string" },
          "message": { "type": "string" },
          "retryable": { "type": "boolean" }
        }
      }
    }
  }
}
