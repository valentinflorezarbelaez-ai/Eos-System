{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EOS Epistemic Best Known Method (BKM) Contract",
  "description": "Schema for reusable architectural patterns and solutions distilled from verified missions",
  "type": "object",
  "required": [
    "schema_version",
    "bkm_id",
    "title",
    "domain",
    "problem_pattern",
    "solution_pattern",
    "tags",
    "created_at",
    "sha256"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": ["1.0.0"]
    },
    "bkm_id": {
      "type": "string",
      "pattern": "^BKM-[A-Z0-9-]+$"
    },
    "title": {
      "type": "string",
      "minLength": 3
    },
    "domain": {
      "type": "string",
      "minLength": 2
    },
    "problem_pattern": {
      "type": "string"
    },
    "solution_pattern": {
      "type": "string",
      "minLength": 5
    },
    "verified_evidence_id": {
      "type": ["string", "null"]
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "created_at": {
      "type": "string"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "additionalProperties": false
}
