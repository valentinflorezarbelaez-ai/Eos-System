{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eos.local/schemas/hitl-receipt.schema.json",
  "title": "EOS Human-in-the-Loop Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "receipt_id",
    "decision",
    "approver",
    "scope",
    "authority_granted",
    "evidence_reviewed",
    "issued_at",
    "expires_at",
    "audit_receipt_hash",
    "fallback"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "receipt_id": {
      "type": "string",
      "pattern": "^HITL-[A-Z0-9-]+$"
    },
    "mission_id": {
      "type": "string",
      "pattern": "^MIS-[A-Z0-9-]+$"
    },
    "task_id": {
      "type": ["string", "null"]
    },
    "gate_id": {
      "type": "string",
      "pattern": "^G[0-9]+-[A-Z0-9-]+$"
    },
    "decision": {
      "enum": ["approve", "approve_with_conditions", "reject", "revoke", "defer"]
    },
    "reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "conditions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "approver": {
      "type": "object",
      "additionalProperties": false,
      "required": ["identity", "identity_type", "authentication_ref"],
      "properties": {
        "identity": {
          "type": "string",
          "minLength": 1
        },
        "identity_type": {
          "enum": ["human_owner", "delegated_human", "authorized_reviewer"]
        },
        "authentication_ref": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mission_id",
        "action_classes",
        "allowed_edit_roots",
        "protected_surfaces",
        "environment"
      ],
      "properties": {
        "mission_id": {
          "type": "string",
          "pattern": "^MIS-[A-Z0-9-]+$"
        },
        "task_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "action_classes": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "allowed_edit_roots": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "protected_surfaces": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "environment": {
          "enum": ["local_read_only", "local_isolated", "staging", "production"]
        }
      }
    },
    "authority_granted": {
      "type": "object",
      "additionalProperties": false,
      "required": ["level", "capabilities", "monotonicity_rule"],
      "properties": {
        "level": {
          "enum": ["LEVEL_0", "LEVEL_1", "LEVEL_2", "LEVEL_3", "LEVEL_4"]
        },
        "capabilities": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "monotonicity_rule": {
          "type": "string",
          "const": "No authority outside this receipt is granted"
        }
      }
    },
    "evidence_reviewed": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "sha256", "status"],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "status": {
            "enum": ["VERIFIED", "NOT_VERIFIED", "NOT_RUN", "UNKNOWN", "BLOCKED", "SIMULATION_ONLY"]
          }
        }
      },
      "minItems": 1
    },
    "issued_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "revoked_at": {
      "type": ["string", "null"],
      "format": "date-time"
    },
    "audit_receipt_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "previous_receipt_hash": {
      "type": ["string", "null"],
      "pattern": "^[a-f0-9]{64}$"
    },
    "fallback": {
      "type": "object",
      "additionalProperties": false,
      "required": ["on_expiry", "on_rejection", "on_scope_violation"],
      "properties": {
        "on_expiry": {
          "enum": ["pause", "revoke", "return_to_human"]
        },
        "on_rejection": {
          "enum": ["cancel", "revise_and_resubmit", "return_to_human"]
        },
        "on_scope_violation": {
          "enum": ["stop_immediately", "quarantine", "return_to_human"]
        }
      }
    }
  }
}
