{
  "version": "2.1.0",
  "$schema": "https://raw.githubusercontent.com/oasis-tcs/sarif-spec/master/Schemata/sarif-schema-2.1.0.json",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "EOS-SecDevOps-Scanner",
          "version": "12.0.0",
          "informationUri": "https://eos-system-ten.vercel.app",
          "rules": [
            {
              "id": "EOS-SEC-001",
              "name": "ZeroPlaintextSecrets",
              "shortDescription": {
                "text": "No plaintext credentials or tokens detected."
              },
              "defaultConfiguration": {
                "level": "error"
              }
            },
            {
              "id": "EOS-SDD-002",
              "name": "SpecificationConformance",
              "shortDescription": {
                "text": "All SDD formal artifacts must be present and verified."
              },
              "defaultConfiguration": {
                "level": "error"
              }
            },
            {
              "id": "EOS-L0-003",
              "name": "HexagonalL0Purity",
              "shortDescription": {
                "text": "Production runtime dependencies must remain zero."
              },
              "defaultConfiguration": {
                "level": "error"
              }
            }
          ]
        }
      },
      "results": []
    }
  ]
}
