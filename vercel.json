{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "eos-site": {
      "root": "site/",
      "outputDirectory": "."
    }
  },
  "rewrites": [
    {
      "source": "/favicon.svg",
      "destination": { "service": "eos-site" }
    },
    {
      "source": "/favicon-32.png",
      "destination": { "service": "eos-site" }
    },
    {
      "source": "/apple-touch-icon.png",
      "destination": { "service": "eos-site" }
    },
    {
      "source": "/styles.css",
      "destination": { "service": "eos-site" }
    },
    {
      "source": "/main.js",
      "destination": { "service": "eos-site" }
    },
    {
      "source": "/chat.js",
      "destination": { "service": "eos-site" }
    },
    {
      "source": "/chat-client.js",
      "destination": { "service": "eos-site" }
    },
    {
      "source": "/index.html",
      "destination": { "service": "eos-site" }
    },
    {
      "source": "/",
      "destination": { "service": "eos-site" }
    }
  ]
}
