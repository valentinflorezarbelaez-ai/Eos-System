{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "eos-site": {
      "root": "site/",
      "outputDirectory": "."
    },
    "flowdesk": {
      "root": "EOS-Lab/FlowDesk/",
      "framework": "hono",
      "entrypoint": "src/index.ts"
    },
    "sonrisa-nova": {
      "root": "EOS-Lab/Sonrisa-Nova/",
      "framework": "astro"
    },
    "luxe-registry": {
      "root": "Luxe-Registry/",
      "framework": "node",
      "entrypoint": "src/server.js"
    },
    "multimodal-creative-suite": {
      "root": "Multimodal-Creative-Suite/",
      "framework": "node",
      "entrypoint": "src/server.js"
    }
  },
  "rewrites": [
    {
      "source": "/favicon.svg",
      "destination": { "service": "eos-site" }
    },
    {
      "source": "/favicon-32.png",
      "destination": { "service": "eos-site" }
    },
    {
      "source": "/apple-touch-icon.png",
      "destination": { "service": "eos-site" }
    },
    {
      "source": "/styles.css",
      "destination": { "service": "eos-site" }
    },
    {
      "source": "/main.js",
      "destination": { "service": "eos-site" }
    },
    {
      "source": "/chat.js",
      "destination": { "service": "eos-site" }
    },
    {
      "source": "/chat-client.js",
      "destination": { "service": "eos-site" }
    },
    {
      "source": "/index.html",
      "destination": { "service": "eos-site" }
    },
    {
      "source": "/",
      "destination": { "service": "eos-site" }
    }
  ]
}
