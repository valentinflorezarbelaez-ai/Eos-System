    "verify:attestation": "node ./scripts/verify-attestation.mjs",
    "fleet": "node ./scripts/verify-fleet.mjs",
    "fleet:verify": "node ./scripts/verify-fleet.mjs",
    "sentinel": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/run-sentinel.ps1",
    "eos": "node ./scripts/eos-cli.mjs"
  },
  "keywords": [
    "eos",
