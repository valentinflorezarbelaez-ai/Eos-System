{
  "name": "eos-system",
  "version": "0.3.0",
  "private": true,
  "description": "Engineering Operating System — Autonomous, reproducible, and auditable engineering control plane.",
  "type": "module",
  "scripts": {
    "test": "node --test tests/*.test.js tests/**/*.test.js",
    "ci": "node scripts/ci/assert-gha-contract.js && node scripts/verify-eos.js --strict",
    "ci:contract": "node scripts/ci/assert-gha-contract.js",
    "mcp:start": "node src/mcp-server.js",
    "eos": "node scripts/cli/eos.js",
    "eos:mission": "node bin/eos.js",
    "eos:mission:help": "node bin/eos.js --help",
    "test:lab": "npx tsx --test EOS-Lab/**/*.test.ts",
    "test:all": "node --test tests/*.test.js tests/**/*.test.js && npx tsx --test EOS-Lab/**/*.test.ts",
    "verify": "node scripts/verify-eos.js",
    "verify:strict": "node scripts/verify-eos.js --strict",
    "verify:json": "node scripts/verify-eos.js --strict --json",
    "simulate:strategies": "node scripts/engine/simulate-strategies.js",
    "prove:factory": "node scripts/engine/autonomous-engineering-factory.js --prove-all",
    "evaluate:self": "node scripts/engine/autonomous-self-evolution-engine.js --eval",
    "run:loop": "node scripts/engine/autonomous-engineering-operating-loop.js --run-loop",
    "evaluate:release": "node scripts/engine/production-readiness-review.js --eval-release",
    "gameday:run": "node scripts/engine/adversarial-laboratory-engine.js --run-gameday",
    "audit:system": "node scripts/engine/system-wide-integrity-audit.js --audit-system",
    "verify:independent": "node scripts/engine/independent-verification-harness.js --verify-independent",
    "discover:real": "node scripts/engine/real-project-discovery-engine.js --discover-real",
    "audit:evidence": "node scripts/verify-eos.js --strict",
    "watch:x": "node scripts/engine/x-learning-watch.js --ingest"
  },
  "keywords": [
    "eos",
    "engineering-operating-system",
    "autonomous-agent",
    "sdd",
    "governance"
  ],
  "author": "EOS Autonomous Engineering System",
  "license": "UNLICENSED"
}
