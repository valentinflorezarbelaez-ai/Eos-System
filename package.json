  "description": "EOS Core System 2.0 - Clean Hexagonal Architecture with Dual-Track Execution Engine and Verifiable Evidence Ledger",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
